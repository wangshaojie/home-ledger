{
  "name": "HomeLedger",
  "version": "1.3.0",
  "description": "家庭支出记账软件 - Windows 桌面端",
  "main": "dist-electron/main.js",
  "author": "HomeLedger",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:no-pack && electron-builder --win portable --x64 --publish never && electron-builder --win nsis --x64 --publish never",
    "build:win": "pnpm run build:no-pack && electron-builder --win portable --x64 --publish never && electron-builder --win nsis --x64 --publish never",
    "build:win:portable": "pnpm run build:no-pack && electron-builder --win portable --x64",
    "build:win:nsis": "pnpm run build:no-pack && electron-builder --win nsis --x64",
    "build:no-pack": "pnpm run type-check && vite build",
    "start": "electron .",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@supabase/supabase-js": "^2.45.4",
    "echarts": "^5.5.1",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@missionsquad/mcp-github": "^0.11.0",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "com.homeledger.app",
    "productName": "家庭记账",
    "copyright": "Copyright © 2026 HomeLedger",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "HomeLedger-${version}-portable-${arch}.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "artifactName": "HomeLedger-setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "家庭记账",
      "deleteAppDataOnUninstall": true,
      "language": "2052",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "wangshaojie",
      "repo": "home-ledger",
      "releaseType": "release",
      "vPrefixedTagName": false,
      "publishAutoUpdate": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}