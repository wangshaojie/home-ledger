# ========================================
# home-ledger 环境变量
# .env 文件本身在 .gitignore 里，不会进 git
# ========================================

# -------- 前端（VITE_ 前缀会进渲染进程 bundle） --------
# Supabase 项目 URL 和 anon key（anon key 设计上就是公开的）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -------- 主进程（不带 VITE_ 前缀，不进 bundle） --------
# Resend API key（纯后端 secret，泄露可被滥用发邮件）
# 改密流程的 OTP 邮件由 Electron 主进程读这个 key 调 Resend API
# 在 Resend Dashboard → API Keys → Create API Key 生成（域名需要先 verified）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
