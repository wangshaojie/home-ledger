# ========================================
# home-ledger 环境变量
# 复制本文件为 .env.local，填入真实值
# .env.local 在 .gitignore 里，不会进 git
# ========================================

# -------- 前端（VITE_ 前缀会进渲染进程 bundle）--------
# Supabase 项目 URL
# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key（新版 Dashboard 的 anon key，2025+ 改名）
# Supabase Dashboard → Project Settings → API → API Keys → Publishable key
# 旧版兼容：也可以用 VITE_SUPABASE_ANON_KEY（Project Settings → API → Project API keys → anon public）
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# -------- 主进程（不带 VITE_ 前缀，不进 bundle）--------
# Resend API key（纯后端 secret，泄露可被滥用发邮件）
# 改密流程的 OTP 邮件由 Electron 主进程读这个 key 调 Resend API
# 在 Resend Dashboard → API Keys → Create API Key 生成（域名需要先 verified）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
